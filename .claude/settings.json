{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || echo python)\" \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/token_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
